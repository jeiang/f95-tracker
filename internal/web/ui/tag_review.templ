package ui

import (
	"net/url"
	"strconv"
)

func reviewField(id int64) string { return "v-" + strconv.FormatInt(id, 10) }

func gameHref(id int64) templ.SafeURL {
	return templ.SafeURL("/games/" + strconv.FormatInt(id, 10))
}

func reviewAction(id int64, suffix string) string {
	return "/games/" + strconv.FormatInt(id, 10) + "/review" + suffix
}

// synonymAction is the Synonym endpoint; the played version rides along so a
// plain-form redirect lands on the same review page.
func synonymAction(gameID int64, version string) string {
	a := reviewAction(gameID, "/synonym")
	if version != "" {
		a += "?version=" + url.QueryEscape(version)
	}
	return a
}

// bulkVerdictData gives a verdict to every present tag that has none yet, and
// can take back exactly the tags its last action set.
const bulkVerdictData = `{
	last: [],
	unmarked(list) {
		const names = [...new Set([...list.querySelectorAll('input[type=radio]')].map(i => i.name))];
		return names.filter(n => !list.querySelector('input[name="' + n + '"]:checked'));
	},
	mark(v) {
		const list = this.$root.nextElementSibling;
		this.last = this.unmarked(list);
		this.last.forEach(n => { list.querySelector('input[name="' + n + '"][value="' + v + '"]').checked = true; });
	},
	undo() {
		const list = this.$root.nextElementSibling;
		this.last.forEach(n => list.querySelectorAll('input[name="' + n + '"]').forEach(i => { i.checked = false; }));
		this.last = [];
	},
}`

templ TagReviewPage(v ReviewView) {
	<a href={ gameHref(v.GameID) } class="text-sm text-muted hover:text-ink">← { v.GameName }</a>
	<h1 class="mt-2 text-2xl font-semibold">Tag review</h1>
	<p class="mt-1 text-sm text-muted">
		if v.Version != "" {
			You played <strong class="font-mono text-ink">{ v.Version }</strong> of <strong class="text-ink">{ v.GameName }</strong>.
		}
		Mark each present tag as correct or wrong. Tags in both the Genre text and the F95 list start as correct.
	</p>
	if v.QueuePos > 0 {
		<p class="mt-1 text-sm text-muted">{ strconv.Itoa(v.QueuePos) } of { strconv.Itoa(v.QueueTotal) } in the queue</p>
	}
	<form id="review-form" method="post" action={ reviewAction(v.GameID, "") } hx-post={ reviewAction(v.GameID, "") } hx-target="#error-slot" hx-swap="innerHTML" class="mt-6 pb-24">
		@templ.Fragment("tag-list") {
			<div id="tag-list">
				if v.Notice != "" {
					<p class="mb-4 rounded-md border border-line bg-surface px-4 py-2 text-sm" role="status">{ v.Notice }</p>
				}
				<datalist id="known-tags">
					for _, l := range v.KnownTags {
						<option value={ l }></option>
					}
				</datalist>
				<section class="panel" aria-labelledby="h-present">
					<div class="flex items-baseline justify-between border-b border-line px-4 py-3">
						<h2 id="h-present" class="font-semibold">Present tags</h2>
						<span class="text-xs text-muted">{ strconv.Itoa(v.MarkedCount()) } of { strconv.Itoa(len(v.Present)) } marked</span>
					</div>
					if len(v.Present) == 0 {
						<p class="px-4 py-3 text-sm text-muted">No present tags need a verdict.</p>
					} else {
						<div
							x-data={ bulkVerdictData }
							x-cloak
							class="flex flex-wrap items-center gap-2 border-b border-line/60 px-4 py-2"
						>
							<span class="text-xs text-muted">Unmarked tags:</span>
							<button type="button" class="btn btn-sm" @click="mark('correct')">All correct</button>
							<button type="button" class="btn btn-sm" @click="mark('wrong')">All wrong</button>
							<button type="button" class="btn btn-sm btn-ghost" x-show="last.length" @click="undo()">Undo (<span x-text="last.length"></span>)</button>
						</div>
						<ul class="divide-y divide-line/60">
							for _, t := range v.Present {
								@reviewRow(v.GameID, v.Version, t, "Correct", "correct", "Wrong", "wrong")
							}
						</ul>
					}
				</section>
				if len(v.Reviewed) > 0 {
					<details class="panel mt-6">
						<summary class="cursor-pointer px-4 py-3">
							<span class="font-semibold">Reviewed before</span>
							<span class="ml-2 text-xs text-muted">({ strconv.Itoa(len(v.Reviewed)) }) unchanged since your last Tag review</span>
						</summary>
						<ul class="divide-y divide-line/60 border-t border-line">
							for _, t := range v.Reviewed {
								@reviewRow(v.GameID, v.Version, t, "Correct", "correct", "Wrong", "wrong")
							}
						</ul>
					</details>
				}
				if len(v.Other) > 0 {
					<details id="other-tags" class="panel mt-6">
						<summary class="cursor-pointer px-4 py-3">
							<span class="font-semibold">Planned &amp; optional tags</span>
							<span class="ml-2 text-xs text-muted">({ strconv.Itoa(len(v.Other)) }) optional, skip if you didn’t notice</span>
						</summary>
						<ul class="divide-y divide-line/60 border-t border-line">
							for _, t := range v.Other {
								@reviewRow(v.GameID, v.Version, t, "Now present", "now_present", "Wrong", "wrong")
							}
						</ul>
					</details>
				}
			</div>
		}
		<div class="fixed inset-x-0 bottom-14 z-40 border-t border-line bg-surface sm:bottom-0">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-4 py-3">
				<p class="hidden text-xs text-muted sm:block">Tags without a verdict stay unverified.</p>
				<div class="ml-auto flex gap-2">
					<button type="submit" class="btn" formaction={ reviewAction(v.GameID, "/skip") } formnovalidate hx-post={ reviewAction(v.GameID, "/skip") } hx-target="#error-slot" hx-swap="innerHTML"><span class="sm:hidden">Skip</span><span class="hidden sm:inline">Skip for now</span></button>
					<button type="submit" class="btn"><span class="sm:hidden">Save</span><span class="hidden sm:inline">Save review</span></button>
					<button type="submit" class="btn btn-primary" name="next" value="1">Save &amp; next</button>
				</div>
			</div>
		</div>
	</form>
}

templ reviewRow(gameID int64, version string, t ReviewItem, firstLabel, firstValue, secondLabel, secondValue string) {
	<li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3">
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<span class="font-medium">{ t.Label }</span>
				if t.Custom {
					@Chip(ChipProps{Tone: "muted", Text: "custom"})
				}
				if t.Qualifier != "present" {
					@Chip(ChipProps{Tone: "info", Text: t.Qualifier})
				}
				if t.IsNew {
					@Chip(ChipProps{Tone: "info", Text: "new"})
				}
				if t.Promoted {
					@Chip(ChipProps{Tone: "accent", Text: "now present at source"})
				}
				if t.RemovedAtSource {
					@Chip(ChipProps{Tone: "bad", Text: "removed at source"})
				}
			</div>
			<div class="mt-0.5 text-xs text-muted">
				{ t.Origin }
				if t.Note != "" {
					· { t.Note }
				}
			</div>
		</div>
		@Seg(SegProps{
			Name: reviewField(t.ID),
			Options: []SegOption{
				{Value: firstValue, Label: firstLabel, Checked: t.Verdict == firstValue},
				{Value: secondValue, Label: secondLabel, Checked: t.Verdict == secondValue},
			},
			Attrs: templ.Attributes{"aria-label": "Verdict for " + t.Label},
		})
		if t.CanSynonym {
			<details class="basis-full">
				<summary class="cursor-pointer text-xs text-muted hover:text-ink">Synonym…</summary>
				<div class="mt-2 grid gap-1">
					<label class="label" for={ "syn-" + reviewField(t.ID) }>Treat “{ t.Phrase }” as</label>
					<div class="flex gap-1">
						<input id={ "syn-" + reviewField(t.ID) } name={ "target-" + strconv.FormatInt(t.ID, 10) } class="field" list="known-tags" autocomplete="off"/>
						<button
							type="submit"
							class="btn btn-sm"
							name="tag"
							value={ strconv.FormatInt(t.ID, 10) }
							formaction={ synonymAction(gameID, version) }
							formnovalidate
							hx-post={ synonymAction(gameID, version) }
							hx-include="#review-form"
							hx-target="#tag-list"
							hx-swap="outerHTML"
						>Save Synonym</button>
					</div>
				</div>
			</details>
		}
	</li>
}
